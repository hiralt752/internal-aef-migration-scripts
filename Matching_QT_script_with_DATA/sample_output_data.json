    "statement": {
      "content": [
        {
          "type": "text",
          "text": "<p><strong>اربطْ كلَّ معلومةٍ ضمنيَّـةٍ بالجملةِ الَّتي تدلُّ عليها فيما يأتي:&nbsp; </strong></p>"
        }
      ]
    },
    "sentence": null,
    "sourceItems": [
      {
        "id": 60,
        "weight": 25.0,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">التَّعلُّمُ الَّذي يتلاشى ويتبخَّرُ هو وقتٌ ضائعٌ.</span></p>"
        },
        "feedback": null
      },
      {
        "id": 483,
        "weight": 25.0,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">الَّذي قام بإنجازِ المهمَّاتِ قبلَ المحاضرةِ حقّقَ فهمًا أفضلَ ممّنِ استمعَ إلى الشَّرحِ أوّلًا.</span></p>"
        },
        "feedback": null
      },
      {
        "id": 876,
        "weight": 25.0,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">التَّعلُّمُ لا ينبغي أنْ يكونَ نسيمًا منعشًا ولا متعةً خالصَةً.</span></p>"
        },
        "feedback": null
      },
      {
        "id": 369,
        "weight": 25.0,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">يمكنُ تنفيذ البرامجِ التّعليميَّةِ بأيّ وقتٍ ودونَ متطلَّبات مُسبقةٍ.</span></p>"
        },
        "feedback": null
      }
    ],
    "targetItems": [
      {
        "id": 11,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">التَّعلُّمُ الحقيقيُّ يُعنى بثباتِ المعلوماتِ.</span></p>"
        }
      },
      {
        "id": 487,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">التَّعلُّمُ الصّعبُ يؤدّي إلى نتيجةٍ أفضلَ.</span></p>"
        }
      },
      {
        "id": 898,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">ضرورةُ بذلِ الجهدِ في التَّعلُّمِ.</span></p>"
        }
      },
      {
        "id": 915,
        "content": {
          "type": "text",
          "text": "<p><span style=\"font-weight: 400;\">تصميمُ التَّعلُّمِ بأسهلِ الطُّرِقِ الممكنةِ.&nbsp;&nbsp;</span></p>"
        }
      }
    ]
  },
