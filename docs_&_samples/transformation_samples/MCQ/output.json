      "timeSpentConfig": null,
      "options": [
        {
          "optionId": 0,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the tenths place is 10 times as much as 8 in the hundredths place.</p>"
            }
          ],
          "feedback": null
        },
        {
          "optionId": 1,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the tenths place is 100 times as much as 8 in the hundredths place.</p>"
            }
          ],
          "feedback": null
        },
        {
          "optionId": 2,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the hundredths  place is 10 times as much as 8 in the tenths place.</p>"
            }
          ],
          "feedback": null
        },
        {
          "optionId": 3,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the hundredths place is \\(1 over 10\\)of 8 in the tenths place.</p>"
            }
          ],
          "feedback": null
        },
        {
          "optionId": 96,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the hundredths place is \\(1 over 100\\)of 8 in the tenths place.</p>"
            }
          ],
          "feedback": null
        },
        {
          "optionId": 686,
          "content": [
            {
              "type": "text",
              "text": "<p>8 in the tenths place is \\(1 over 10\\)of 8 in the hundredths place.</p>"
