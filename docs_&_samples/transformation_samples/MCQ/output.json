          {
            "type": "text",
            "text": "<p><span style=\"font-style: italic; font-weight: bold; color: #1774aa;\">Select the correct answer</span></p>\n<p>Choose two different ways to describe the relationship between the digit 8 in the number 3.882  </p>"
          },
          {
            "type": "image",
            "image": {
              "url": "../alef-assessment-content/data/ccl/assessment/questions/2022/05/28/12/05/1YqgQpQqTO.jpg",
